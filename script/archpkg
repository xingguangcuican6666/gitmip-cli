#!/bin/bash
#
# Wrap a staged file tree in an Arch Linux package.
#
# Usage:
#   script/archpkg <stage-dir> <version> <goarch> <out-dir>
#
# The staged tree must already be the install layout, for example
# <stage-dir>/usr/bin/gm. Writes
# <out-dir>/gitmip-cli-<pkgver>-1-<pkgarch>.pkg.tar.zst, which `pacman -U` and
# `pacman -Qp` accept.
#
# The package is named after the project, gitmip-cli, while the command it
# installs is gm. Those are two different names: pacman tracks the software, the
# shell runs the binary.
#
# The package is assembled directly instead of with makepkg or nfpm: makepkg
# refuses to run as root, which CI containers often are, and wants a PKGBUILD
# tree, while nfpm is not a dependency of this module. What pacman actually reads
# is a text .PKGINFO file plus the files themselves inside a zstd tarball, which
# is a few lines of shell.

set -euo pipefail

if [ $# -lt 4 ]; then
  echo "usage: script/archpkg <stage-dir> <version> <goarch> <out-dir>" >&2
  exit 1
fi

stage="$1"
version="$2"
goarch="$3"
outdir="$4"

if [ ! -d "$stage" ]; then
  echo "archpkg: no such stage directory: $stage" >&2
  exit 1
fi

# Arch names packages after the CPU architecture, not after Go's GOARCH.
case "$goarch" in
  amd64) pkgarch=x86_64 ;;
  arm64) pkgarch=aarch64 ;;
  386) pkgarch=i686 ;;
  arm) pkgarch=armv7h ;;
  *)
    echo "archpkg: no Arch architecture for GOARCH $goarch" >&2
    exit 1
    ;;
esac

# pacman's pkgver may only contain letters, digits and . _ +, and may not
# contain a hyphen: everything after the last hyphen in the file name is read as
# pkgrel. Drop the leading v and turn the separators git describe uses into dots,
# so v2.103.3-57-g46d29d4df becomes 2.103.3.57.g46d29d4df.
pkgver="${version#v}"
pkgver="${pkgver//-/.}"
pkgver="$(printf '%s' "$pkgver" | tr -c 'A-Za-z0-9._+' '.' | sed 's/\.\+$//')"
if [ -z "$pkgver" ]; then
  pkgver=0.unknown
fi
pkgrel=1

out="${outdir}/gitmip-cli-${pkgver}-${pkgrel}-${pkgarch}.pkg.tar.zst"
mkdir -p "$outdir"
# zstd refuses to overwrite an existing output, so a rebuild would fail on the
# previous package instead of replacing it.
rm -f "$out" "$out.sha256"

builddate="$(date +%s)"
if [ -n "${SOURCE_DATE_EPOCH:-}" ]; then
  builddate="$SOURCE_DATE_EPOCH"
fi

# Normalize the staged tree before packaging. pacman installs whatever ownership
# and modes the archive records, so a package built by a non-root user would
# otherwise install files owned by that user's uid. Directories are 755, anything
# under usr/bin is 755, everything else is 644, matching what a PKGBUILD
# produces. The usr/bin branch is conditional because a package may legitimately
# stage no executables, and find exits non-zero on a path that does not exist.
find "$stage" -type d -exec chmod 755 {} +
find "$stage" -type f ! -path "*/usr/bin/*" -exec chmod 644 {} +
if [ -d "$stage/usr/bin" ]; then
  find "$stage/usr/bin" -type f -exec chmod 755 {} +
fi

# Installed size is what `pacman -Qi` reports, in bytes. `du -b` is GNU-only, and
# `find -exec wc -c {} +` with no matches would run wc against stdin and block,
# so count with a glob that is allowed to be empty.
size=0
while IFS= read -r f; do
  size=$((size + $(wc -c < "$f")))
done < <(find "$stage/usr" -type f)

cat > "$stage/.PKGINFO" <<EOF
# Generated by script/archpkg
pkgname = gitmip-cli
pkgbase = gitmip-cli
pkgver = ${pkgver}-${pkgrel}
pkgdesc = Command line tool for GitHub and Gitea, forked from the GitHub CLI
url = https://github.com/xingguangcuican6666/gitmip-cli
builddate = ${builddate}
packager = gitmip-cli maintainers
size = ${size}
arch = ${pkgarch}
license = MIT
depend = git
EOF
chmod 644 "$stage/.PKGINFO"

# .MTREE is the file manifest pacman uses for `pacman -Qkk`. pacman does not
# require it, so it is generated only when bsdtar is around. Ownership is forced
# to root/root because that is what the files will be installed as.
entries=(.PKGINFO usr)
if command -v bsdtar >/dev/null 2>&1; then
  ( cd "$stage" && bsdtar -czf .MTREE --format=mtree \
      --uid 0 --gid 0 --uname root --gname root \
      --options='!all,use-set,type,uid,gid,mode,time,size,md5,sha256,link' \
      .PKGINFO usr )
  chmod 644 "$stage/.MTREE"
  entries=(.PKGINFO .MTREE usr)
fi

# Write the archive with fixed ownership and numeric ids, so it does not record
# whoever ran the build. GNU tar and bsdtar spell that differently, and macOS has
# no GNU tar, so pick by what is actually available.
if tar --version 2>/dev/null | grep -q GNU && command -v zstd >/dev/null 2>&1; then
  tar --owner=0 --group=0 --numeric-owner -C "$stage" -cf - "${entries[@]}" \
    | zstd -q -T0 -19 -o "$out"
elif command -v bsdtar >/dev/null 2>&1; then
  ( cd "$stage" && bsdtar --zstd --uid 0 --gid 0 -cf "$out" "${entries[@]}" )
else
  echo "archpkg: need GNU tar with zstd, or bsdtar, to write a .pkg.tar.zst" >&2
  exit 1
fi

if command -v sha256sum >/dev/null 2>&1; then
  ( cd "$outdir" && sha256sum "$(basename "$out")" > "$(basename "$out").sha256" )
else
  ( cd "$outdir" && shasum -a 256 "$(basename "$out")" > "$(basename "$out").sha256" )
fi

echo "$out"